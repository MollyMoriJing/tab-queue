{
  "manifest_version": 3,
  "name": "Tab Queue",
  "version": "0.1.1",
  "description": "Capture unfinished tabs, close them safely, and come back at the right time.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "notifications",
    "sidePanel"
  ],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Tab Queue",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "quick-save-current-tab": {
      "suggested_key": {
        "default": "Alt+Shift+Q",
        "mac": "Option+Shift+Q"
      },
      "description": "Quick save the current tab into Later"
    }
  }
}
